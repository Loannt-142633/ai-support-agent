APP_NAME=AI Support Agent
APP_ENV=production
DEBUG=false
DEMO_STAFF_AUTH_ENABLED=false
DEMO_STAFF_ID=local-demo-staff
DEMO_STAFF_TICKET_IDS=[]
DATABASE_URL=postgresql+psycopg://app:app@db:5432/ai_support_agent

# JSON list of allowed browser origins
CORS_ORIGINS=["http://localhost:3000"]
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT=30
EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_DIMENSION=768
DOCUMENT_STORAGE_DIR=uploads/documents
MAX_DOCUMENT_SIZE_BYTES=52428800
MAX_CHUNK_SIZE=500
MAX_DISTANCE=0.24
RABBITMQ_URL=amqp://app:app@rabbitmq:5672/
RABBITMQ_MANAGEMENT_URL=http://rabbitmq:15672
DOCUMENT_INGESTION_QUEUE=document.ingestion
TICKET_ANALYSIS_QUEUE=ticket.analysis

# Required only when sending an approved suggested answer by email.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM_EMAIL=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_TIMEOUT=30
