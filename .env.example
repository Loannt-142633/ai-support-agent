APP_NAME=AI Support Agent
DEBUG=false
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/ai_support_agent

# Optional comma-separated CORS origins
CORS_ORIGINS=http://localhost:3000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT=30
EMBEDDING_MODEL=intfloat/multilingual-e5-base
EMBEDDING_DIMENSION=768
DOCUMENT_STORAGE_DIR=uploads/documents
MAX_DOCUMENT_SIZE_BYTES=52428800
MAX_CHUNK_SIZE=500
